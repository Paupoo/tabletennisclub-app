APP_NAME="CTT Ottignies-Blocry"
APP_ENV=local
APP_KEY=
# Never true in production: the error pages print the environment, the
# database credentials and the full stack trace to whoever triggers them.
APP_DEBUG=false
APP_URL=http://localhost
APP_CLUB_BUILDING_NAME=
APP_CLUB_STREET=
APP_CLUB_ZIP_CODE=
APP_CLUB_CITY=
APP_CLUB_OSM_LINK=
APP_CLUB_EMAIL=
APP_CLUB_PHONE_NUMBER=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# Never sync in production: every mail would then be sent inside the request
# that triggered it, and a slow relay becomes a slow page for the member.
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Uncomment in production (HTTPS only): keeps the session cookie off plain
# HTTP. Leaving it on in local development logs you out of http://localhost.
# SESSION_SECURE_COOKIE=true

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ── Feature flags ────────────────────────────────────────────────────────────
# Un drapeau par domaine fonctionnel. Tout est activé par défaut : ne renseigner
# une clé que pour ÉTEINDRE un domaine jugé immature dans cet environnement.
# Un domaine éteint disparaît partout à la fois — routes (404), navigation,
# tâches planifiées et calendrier public.
FEATURE_BAR=true
FEATURE_CASH_REGISTER=true
FEATURE_CONTACTS=true
FEATURE_HELP_CENTRE=true
FEATURE_INTERCLUBS=true
FEATURE_MEETINGS=true
FEATURE_SUPERVISION=true
FEATURE_TOURNAMENTS=true
FEATURE_TRAINING_PLANNING=true
FEATURE_TRAININGS=true
FEATURE_TREASURY=true
FEATURE_WEBSITE=true
