includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:

    paths:
        - app/

    # Level 10 is the highest level
    level: 5

    ignoreErrors:
        # view() helper: phpstan cannot resolve Blade view names to a
        # view-string without a Blade analysis extension. Not real bugs.
        -
            identifier: argument.type
            message: '#expects view-string\|null, string given\.#'

        # larastan over-asserts non-null on belongsTo/first()/find()/morphTo,
        # so it flags defensive `?->` before `??` as unnecessary. The FKs are
        # genuinely nullable; the nullsafe access is correct. Cosmetic-only
        # rule that can never hide a real bug.
        - identifier: nullsafe.neverNull

#    excludePaths:
#        - ./*/*/FileToBeExcluded.php