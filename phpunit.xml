<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         beStrictAboutOutputDuringTests="true"
         failOnRisky="true"
         failOnWarning="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
        <testsuite name="Browser">
            <directory>tests/Browser</directory>
        </testsuite>
        <!--
            Calls api.aftt.be for real. Deliberately absent from the suites
            `composer test` runs: it is the canary for a federation API change
            that the committed fixtures cannot see, and it is run on purpose.
        -->
        <testsuite name="Contract">
            <directory>tests/Contract</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>app</directory>
        </include>
        <exclude>
            <!-- Fichiers Laravel de base -->
            <directory suffix=".php">app/Console</directory>
            <directory suffix=".php">app/Exceptions</directory>
            <directory suffix=".php">app/Providers</directory>

            <!-- Les sous-classes de middleware du squelette Laravel 10 n'existent
                 plus : elles ne surchargeaient rien et le framework fournit les
                 siennes. Seul RedirectIfAuthenticated reste, avec sa redirection
                 propre au projet. -->
            <file>app/Http/Middleware/RedirectIfAuthenticated.php</file>

            <!-- Si vous avez des helpers/config -->
            <!-- <directory>app/Helpers</directory> -->
        </exclude>
    </source>

    <php>
        <!-- Environment -->
        <ini name="memory_limit" value="1G"/>
        <env name="APP_ENV" value="testing" />
        <!-- Force an in-memory sqlite database for tests. Without this the suite
             falls back to .env (DB_DATABASE=laravel, the dev file DB): every run
             would migrate/refresh the developer's database, and parallel workers
             hammering one file can corrupt it ("database disk image is malformed"). -->
        <env name="DB_CONNECTION" value="sqlite" force="true" />
        <env name="DB_DATABASE" value=":memory:" force="true" />
        <!-- Array cache is per-process and reset with the app each test: no file-cache
             directory races under parallel testing, and no cross-test cache leakage. -->
        <env name="CACHE_DRIVER" value="array" />
        <!-- Everything below used to live only in .env.testing, which is not
             tracked. The suite was therefore green on a machine that happened to
             have that file and red on a fresh clone: the first CI run lost 22
             tests to TransportException, because .env.example asks for SMTP and
             no mail server answers on a runner. Forced here so the suite carries
             its own environment and CI cannot drift from a laptop again.

             Keep .env.testing in step with this block if you edit it; these values
             mirror it exactly. -->
        <env name="MAIL_MAILER" value="array" force="true" />
        <!-- sync runs queued work inline, so a test asserting on the effect of a
             job does not have to drain a queue table. -->
        <env name="QUEUE_CONNECTION" value="sync" force="true" />
        <env name="SESSION_DRIVER" value="array" force="true" />
        <!-- The default 12 rounds are deliberately slow; every factory that makes
             a user pays for them. -->
        <env name="BCRYPT_ROUNDS" value="4" force="true" />
    </php>

    <!-- Il n'y a volontairement plus de bloc <coverage><report>. Déclarer un
         rapport le rend obligatoire à chaque exécution : les workers parallèles
         doivent alors produire un fichier de couverture, et sur une machine sans
         driver — un runner CI en `coverage: none` — paratest s'arrête sur
         MissingResultsException alors que les 3101 tests viennent de passer.

         En local l'effet était l'inverse mais aussi coûteux : Xdebug étant
         présent, chaque `composer test` réécrivait tests/Coverage/html.

         La couverture reste disponible à la demande, via les options de ligne
         de commande « coverage » et « coverage-html » de `php artisan test`.
         Le bloc <source> ci-dessus continue de définir ce qui est mesuré. -->
</phpunit>
