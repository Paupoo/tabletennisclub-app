includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    # 142 pre-existing errors, frozen on 2026-08-01 so that CI can go red on new
    # ones. Mostly larastan not resolving dynamic Eloquent properties. Shrink it
    # by fixing entries, never by regenerating it to absorb a new error.
    - phpstan-baseline.neon

parameters:

    paths:
        - app/

    # Level 10 is the highest level
    level: 5

    ignoreErrors:
        # view() helper: phpstan cannot resolve Blade view names to a
        # view-string without a Blade analysis extension. Not real bugs.
        -
            identifier: argument.type
            message: '#expects view-string\|null, string given\.#'

        # larastan over-asserts non-null on belongsTo/first()/find()/morphTo,
        # so it flags defensive `?->` before `??` as unnecessary. The FKs are
        # genuinely nullable; the nullsafe access is correct. Cosmetic-only
        # rule that can never hide a real bug.
        - identifier: nullsafe.neverNull

        # `Interclub::users()` aliases its pivot with ->as('registration'), so
        # $user->registration is a dynamic accessor larastan cannot resolve.
        # The pattern is not new — it only became visible when this code moved
        # out of resources/views/pages, which `paths` does not analyse.
        -
            identifier: property.notFound
            message: '#User::\$registration\.#'
            path: app/Domains/Competitions/Interclub/Services/InterclubPreparationService.php

        # Livewire v4 single-file components live under resources/views/pages,
        # outside `paths`. A trait used only by them therefore looks unused.
        # Scoped to the concerns folder so a genuinely dead trait elsewhere
        # still fails.
        -
            identifier: trait.unused
            path: app/Livewire/Concerns/*

#    excludePaths:
#        - ./*/*/FileToBeExcluded.php